  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-extract tokens from login responses",
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "    const responseJson = pm.response.json();",
          "    if (responseJson.data && responseJson.data.tokens) {",
          "        pm.collectionVariables.set('accessToken', responseJson.data.tokens.accessToken);",
          "        pm.collectionVariables.set('refreshToken', responseJson.data.tokens.refreshToken);",
          "    }",
          "    if (responseJson.data && responseJson.data.user) {",
          "        if (responseJson.data.user.role === 'patient') {",
          "            pm.collectionVariables.set('patientId', responseJson.data.user.id);",
          "        } else if (responseJson.data.user.role === 'provider') {",
          "            pm.collectionVariables.set('providerId', responseJson.data.user.id);",
          "        }",
          "    }",
          "}",
          "",
          "// Auto-extract IDs from creation responses",
          "if (pm.response.code === 201) {",
          "    const responseJson = pm.response.json();",
          "    if (responseJson.data && responseJson.data.id) {",
          "        if (pm.request.url.path.includes('appointments')) {",
          "            pm.collectionVariables.set('appointmentId', responseJson.data.id);",
          "        } else if (pm.request.url.path.includes('availability')) {",
          "            pm.collectionVariables.set('availabilitySlotId', responseJson.data.id);",
          "        }",
          "    }",
          "}"
        ]
      }
    }
  ]
